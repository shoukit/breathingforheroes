---
/**
 * The portrait is real photography supplied by the client — the one image on the
 * site that shows an actual person. It is framed to head and shoulders on purpose:
 * the full frame is a lotus-position meditation shot, and the home page argues that
 * breathwork is what you do when sitting still does not work.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import PageHero from '../components/PageHero.astro';
import { person } from '../data/site';
import tom from '../assets/tom-portrait.jpg';
import fluss from '../assets/fluss.jpg';

const title = 'Tom Geier — Breathwork Instructor in Bonn';
const description =
  'Wie ich zum Breathwork gekommen bin und wie ich arbeite. Zertifizierter Instructor, Einzel- und Gruppensessions in Bonn und online.';

const stance = [
  {
    title: 'Ich verspreche nichts',
    body: 'Ich weiß nicht, was eine Session bei dir auslöst. Ich kann dir sagen, was passieren wird — nicht, was du dabei erleben wirst.',
  },
  {
    title: 'Du entscheidest, wie viel du erzählst',
    body: 'Manche kommen mit einem klaren Thema, andere wollen einfach nur atmen. Beides funktioniert.',
  },
  {
    title: 'Ich bleibe die ganze Zeit dabei',
    body: 'Während der Atemrunde bin ich im Raum, ansprechbar und aufmerksam. Du machst das nicht allein.',
  },
  {
    title: 'Ich sage auch ab',
    body: 'Wenn ich den Eindruck habe, dass Breathwork gerade nicht das Richtige für dich ist, sage ich das — auch wenn ich damit einen Termin verliere.',
  },
];

const personSchema = {
  '@type': 'Person',
  name: person.name,
  jobTitle: person.role,
  url: 'https://breathing-for-heroes.de/ueber-tom/',
  worksFor: { '@id': 'https://breathing-for-heroes.de/#practice' },
};
---

<Base title={title} description={description} schema={[personSchema]}>
  <PageHero
    image={fluss}
    eyebrow="Wer dich anleitet"
    title={person.name}
    lead={`${person.role} in Bonn.`}
    focus="center 55%"
  />

  <section class="band band--tight" aria-labelledby="weg">
    <div class="shell">
      <div class="lane">
        <div class="intro">
          <figure class="portrait" data-reveal>
            <Image
              src={tom}
              alt={`${person.name}, ${person.role} in Bonn`}
              widths={[360, 560, 800]}
              sizes="(min-width: 52rem) 360px, 100vw"
              loading="eager"
              quality={82}
            />
          </figure>

          <blockquote class="pull" data-reveal>
            <p>Es gab einen Punkt, an dem ich gemerkt habe: So geht es nicht weiter.</p>
          </blockquote>
        </div>

        <div class="prose" data-reveal>
          <h2 id="weg">Wie ich dazu gekommen bin</h2>
          <p>
            Mehr Verantwortung im Job, immer schneller, immer mehr — und irgendwann war ich
            erschöpft, unausgeglichen und innerlich leer. Von außen hat das niemand gesehen.
          </p>
          <p>
            2019 habe ich angefangen, mich damit zu beschäftigen. Erst Meditation, dann verschiedene
            Atemtechniken, unter anderem die Wim-Hof-Methode. Das hat schon viel verändert. Aber die
            erste richtige Breathwork-Session war noch einmal etwas anderes. Ich hätte nicht gedacht,
            dass allein durch Atmung so viel möglich ist.
          </p>
          <p>
            Seitdem ist Breathwork fester Teil meines Lebens. Einmal pro Woche nehme ich mir die
            Zeit, und jedes Mal ist es anders.
          </p>
          <p>
            Irgendwann wollte ich das weitergeben. Heute bin ich zertifizierter Breathwork Instructor
            und leite Menschen durch genau das, was mir damals geholfen hat.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--sunk" aria-labelledby="haltung">
    <div class="shell">
      <div class="lane">
        <div class="section-head" data-reveal>
          <span class="mono">Haltung</span>
          <h2 id="haltung">Wie ich arbeite</h2>
        </div>

        <ul class="stance">
          {
            stance.map((item) => (
              <li data-reveal>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Cta
    heading="Wenn du dich damit wohlfühlst"
    body="Schreib mir. Wir klären in ein paar Sätzen, ob es passt."
  />
</Base>

<style>
  .page-hero .mono {
    margin-bottom: var(--space-md);
  }

  .page-hero .lead {
    margin-top: var(--space-md);
  }

  .intro {
    display: grid;
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
    align-items: center;
  }

  .portrait {
    margin: 0;
  }

  /* The crop is baked into tom-portrait.jpg rather than done with object-position:
     the source frame is a full lotus-position shot, and CSS cover can only reframe
     within the image, never zoom past it — the pose stayed in view. */
  .portrait :global(img) {
    width: 100%;
    max-width: 400px;
    border-radius: var(--radius-lg);
  }

  .pull {
    margin: 0;
    padding-left: var(--space-lg);
    border-left: 2px solid var(--accent);
  }

  @media (min-width: 52rem) {
    .intro {
      grid-template-columns: minmax(280px, 360px) minmax(0, 1fr);
      gap: var(--space-2xl);
    }

  }

  .pull p {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 2.25rem);
    line-height: 1.24;
    letter-spacing: -0.012em;
    /* On the paragraph, not the blockquote: ch resolves against the element's own
       font-size, and on the wrapper that is the inherited body size — which cut the
       measure to about a third of what it looked like. */
    max-width: 20ch;
  }

  .stance {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-lg);
  }

  .stance li {
    padding-top: var(--space-md);
    border-top: 1px solid var(--line-strong);
  }

  .stance h3 {
    font-family: var(--font-body);
    font-size: var(--step-body);
    font-weight: 600;
  }

  .stance p {
    color: var(--ink-soft);
    margin-top: var(--space-xs);
    font-size: var(--step-small);
  }

  @media (min-width: 52rem) {
    .stance {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-xl);
    }
  }
</style>
