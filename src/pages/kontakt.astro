---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import fenster from '../assets/fenster.jpg';
import { contact, formEndpoint, venues } from '../data/site';

const title = 'Kontakt & Terminanfrage — Breathwork Bonn | Tom Geier';
const description =
  'Termin für eine Breathwork-Session in Bonn oder online anfragen. Telefonisch unter +49 176 34966935 oder über das Formular.';

/** Until an endpoint is configured the form stays off and the real channels carry the page. */
const formLive = formEndpoint.length > 0;

const topics = [
  'Einzelsession',
  'Gruppensession',
  'Eisbaden',
  'Ich weiß es noch nicht',
];

const mailSubject = encodeURIComponent('Terminanfrage');

/**
 * A blank mail client is its own kind of friction — the reader has to work out what
 * Tom needs to know. Pre-filling turns it into filling in blanks, and it costs
 * nothing to run because it is a plain mailto.
 */
const mailBody = encodeURIComponent(
  [
    'Hallo Tom,',
    '',
    'ich würde gern einen Termin ausmachen.',
    '',
    'Interesse an: (Einzelsession / Gruppensession / Eisbaden / weiß ich noch nicht)',
    'Lieber: (im Garten / bei mir zu Hause / in der Natur / online über Zoom)',
    'Worum es mir geht:',
    '',
    'Meine Fragen:',
    '',
    'Viele Grüße',
  ].join('\n')
);

const mailHref = `mailto:${contact.email}?subject=${mailSubject}&body=${mailBody}`;

/** Process transparency on the page where hesitation actually costs the enquiry. */
const next = [
  'Du schreibst mir — ein oder zwei Sätze reichen.',
  'Ich melde mich zurück, und wir klären das Wesentliche: was du suchst, ob etwas gegen die Methode spricht, Einzel oder Gruppe.',
  'Wir machen einen Termin aus. Bezahlt wird nach der Session, nicht vorher.',
];
---

<Base title={title} description={description}>
  <PageHero
    image={fenster}
    eyebrow="Kontakt"
    title="Termin anfragen"
    lead="Ein oder zwei Sätze reichen. Erzähl kurz, worum es dir geht — den Rest klären wir miteinander."
    focus="center 50%"
  />

  <section class="band band--tight">
    <div class="shell">
      <div class="lane contact-grid">
        <div data-reveal>
          {
            formLive ? (
              <form class="form" method="post" action={formEndpoint}>
                <p class="form__hp" aria-hidden="true">
                  <label for="website">Bitte leer lassen</label>
                  <input id="website" type="text" name="website" tabindex="-1" autocomplete="off" />
                </p>

                <div class="field">
                  <label for="name">
                    Name <span class="req">(Pflichtfeld)</span>
                  </label>
                  <input id="name" name="name" type="text" autocomplete="name" required />
                </div>

                <div class="field">
                  <label for="email">
                    E-Mail <span class="req">(Pflichtfeld)</span>
                  </label>
                  <input id="email" name="email" type="email" autocomplete="email" required />
                </div>

                <div class="field">
                  <label for="phone">Telefon <span class="opt">(optional)</span></label>
                  <input id="phone" name="phone" type="tel" autocomplete="tel" />
                </div>

                <div class="field">
                  <label for="topic">Worum geht es?</label>
                  <select id="topic" name="topic">
                    {topics.map((t) => (
                      <option value={t}>{t}</option>
                    ))}
                  </select>
                </div>

                <div class="field">
                  <label for="message">
                    Nachricht <span class="req">(Pflichtfeld)</span>
                  </label>
                  <textarea
                    id="message"
                    name="message"
                    rows="6"
                    required
                    placeholder="Erzähl kurz, worum es dir geht. Wenn du Fragen hast, stell sie einfach hier."
                  />
                </div>

                <div class="field field--check">
                  <input id="privacy" name="privacy" type="checkbox" required />
                  <label for="privacy">
                    Ich habe die <a href="/datenschutz/">Datenschutzerklärung</a> gelesen und bin
                    damit einverstanden, dass meine Angaben zur Bearbeitung meiner Anfrage
                    gespeichert werden. <span class="req">(Pflichtfeld)</span>
                  </label>
                </div>

                <button class="btn btn--primary" type="submit">Anfrage senden</button>
              </form>
            ) : (
              <div class="direct">
                <ul class="channels">
                  <li>
                    <a class="channel channel--primary" href={mailHref}>
                      <Icon name="Mail" size={22} />
                      <span>
                        <strong>Mail schreiben</strong>
                        <span class="channel__hint">{contact.email}</span>
                      </span>
                    </a>
                  </li>
                  <li>
                    <a class="channel" href={`tel:${contact.phoneHref}`}>
                      <Icon name="Phone" size={22} />
                      <span>
                        <strong>Anrufen</strong>
                        <span class="channel__hint">{contact.phone}</span>
                      </span>
                    </a>
                  </li>
                </ul>

                <p class="direct__note">
                  Die Mail ist schon vorbereitet — du musst sie nur noch ausfüllen und abschicken.
                  Unverbindlich, und ich antworte selbst.
                </p>

                <h2 class="next__head mono">Was danach passiert</h2>
                <ol class="next">
                  {next.map((item) => <li>{item}</li>)}
                </ol>
              </div>
            )
          }
        </div>

        <aside class="aside" data-reveal>
          {
            /* Only shown alongside the form. In the fallback the channels above already
               carry the phone number and address, and repeating them reads as filler. */
            formLive && (
              <div class="aside__block">
                <h2 class="mono">Lieber direkt</h2>
                <ul class="plain">
                  <li>
                    <Icon name="Phone" size={17} />
                    <a href={`tel:${contact.phoneHref}`}>{contact.phone}</a>
                  </li>
                  <li>
                    <Icon name="Mail" size={17} />
                    <a href={`mailto:${contact.email}`}>{contact.email}</a>
                  </li>
                </ul>
              </div>
            )
          }

          <div class="aside__block">
            <h2 class="mono">Wo die Sessions stattfinden</h2>
            {/* No studio and no practice room — so this lists the actual options
                rather than an address, which would promise a venue that does not exist. */}
            <ul class="venues">
              {venues.map((v) => (
                <li>
                  <strong>{v.name}</strong>
                  <span>{v.detail}</span>
                </li>
              ))}
            </ul>
            <p class="aside__hint">
              Wo genau, klären wir vorher zusammen — es soll ein Ort sein, an dem du dich
              ungestört fühlst.
            </p>
          </div>

        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .mono:first-child {
    margin-bottom: var(--space-md);
  }

  /* Kept tight so the first real action stays above the fold on a 844px phone. */
  .contact-lead {
    margin-top: var(--space-md);
  }

  .contact-grid {
    display: grid;
    gap: var(--space-2xl);
    margin-top: var(--space-xl);
  }

  /* ---- Form ---- */

  .form {
    display: grid;
    gap: var(--space-lg);
    max-width: 34rem;
  }

  .form__hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .field {
    display: grid;
    gap: var(--space-xs);
  }

  .field label {
    font-weight: 500;
    font-size: var(--step-small);
  }

  .req,
  .opt {
    font-weight: 400;
    color: var(--ink-soft);
  }

  input[type='text'],
  input[type='email'],
  input[type='tel'],
  select,
  textarea {
    min-height: var(--tap);
    padding: 0.7rem 0.85rem;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-size: var(--step-body);
    width: 100%;
  }

  textarea {
    resize: vertical;
    line-height: 1.6;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    border-color: var(--accent);
  }

  .field--check {
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-sm);
  }

  .field--check input {
    width: 22px;
    height: 22px;
    margin-top: 0.15em;
    accent-color: var(--accent);
  }

  .field--check label {
    font-weight: 400;
    color: var(--ink-soft);
  }

  .field--check a {
    color: var(--accent);
  }

  /* ---- Direct contact fallback ---- */

  .channels {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
    max-width: 30rem;
  }

  .channel {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    min-height: var(--tap);
    padding: var(--space-md);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color var(--t-base) var(--ease), background-color var(--t-base) var(--ease);
  }

  /* Writing is the lower-hurdle channel for this audience — a phone call about
     being exhausted is a real barrier. So mail leads and the phone stays quiet. */
  .channel--primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .channel--primary:hover {
    background: var(--accent-bright);
    border-color: var(--accent-bright);
  }

  .channel--primary :global(svg),
  .channel--primary .channel__hint {
    color: color-mix(in srgb, #fff 82%, var(--accent));
  }

  .channel:not(.channel--primary):hover {
    border-color: var(--accent);
    background: rgb(14 74 84 / 0.04);
  }

  .channel :global(svg) {
    flex: none;
    color: var(--accent);
  }

  .channel span {
    display: grid;
  }

  .channel strong {
    font-weight: 600;
    word-break: break-word;
  }

  .channel__hint {
    font-family: var(--font-mono);
    font-size: var(--step-mono);
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  .direct__note {
    margin-top: var(--space-md);
    color: var(--ink-soft);
    font-size: var(--step-small);
    max-width: 46ch;
  }

  .next__head {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
  }

  .next {
    margin: 0;
    padding-left: 1.2em;
    max-width: 46ch;
    color: var(--ink-soft);
    font-size: var(--step-small);
  }

  .next li {
    margin-block: var(--space-xs);
  }

  /* ---- Aside ---- */

  .aside {
    display: grid;
    gap: var(--space-xl);
    align-content: start;
  }

  .aside__block h2 {
    margin-bottom: var(--space-sm);
  }

  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .plain li,
  .with-icon {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .aside :global(svg) {
    flex: none;
    color: var(--accent);
    margin-top: 0.9em;
  }

  .aside a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--accent);
    text-underline-offset: 0.2em;
  }

  .aside address {
    font-style: normal;
    padding-block: 0.6em;
  }

  .venues {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }

  .venues li {
    display: grid;
    gap: 0.15rem;
  }

  .venues span {
    color: var(--ink-soft);
    font-size: var(--step-small);
  }

  .aside__hint {
    color: var(--ink-soft);
    font-size: var(--step-small);
    margin-top: var(--space-sm);
    max-width: 42ch;
  }

  @media (min-width: 60rem) {
    .contact-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--space-2xl);
    }
  }
</style>
