---
/**
 * The closing block. Every page ends with exactly one of these, and it carries the
 * page's single primary CTA. No page renders a second filled button.
 */
import { primaryCta } from '../data/site';

interface Props {
  heading: string;
  body: string;
  /** Overridable, but every page carries one — the hesitation it answers is real. */
  note?: string;
}

const {
  heading,
  body,
  note = 'Unverbindlich. Es antwortet niemand aus einem Team, sondern Tom selbst.',
} = Astro.props;
---

<section class="band band--sunk">
  <div class="shell">
    <div class="lane cta" data-reveal>
      <h2>{heading}</h2>
      <p class="lead">{body}</p>
      <a class="btn btn--primary" href={primaryCta.href}>{primaryCta.label}</a>
      <p class="cta__note">{note}</p>
    </div>
  </div>
</section>

<style>
  .cta h2 {
    max-width: 20ch;
  }

  .cta .lead {
    margin-top: var(--space-md);
  }

  .cta .btn {
    margin-top: var(--space-lg);
  }

  .cta__note {
    margin-top: var(--space-md);
    color: var(--ink-soft);
    font-size: var(--step-small);
    max-width: 44ch;
  }
</style>
