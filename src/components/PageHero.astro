---
/**
 * The header every page other than the home page uses: type over full-bleed
 * photography, matching the home hero so the site reads as one thing.
 *
 * Shallower than the home hero on purpose — a subpage header that fills the
 * viewport delays the content the visitor came for. It is tall enough to set the
 * mood and short enough that the first paragraph is visible without scrolling.
 *
 * The scrim is not decoration: it is what keeps the text at 4.5:1 over an image
 * whose brightness varies across the frame. `alt` is empty because the image is
 * atmosphere — the heading beside it already carries the meaning.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  eyebrow: string;
  title: string;
  lead?: string;
  /** Vertical framing, e.g. "center 30%", when the subject sits off-centre. */
  focus?: string;
}

const { image, eyebrow, title, lead, focus = 'center 50%' } = Astro.props;

/**
 * Framing is applied through a data attribute rather than an inline style, so the
 * page carries no style attributes and the CSS stays in one place. Each value used
 * needs a rule below.
 */
---

<section class="page-hero">
  <div class="page-hero__media" data-focus={focus}>
    <Image
      src={image}
      alt=""
      widths={[768, 1280, 1920, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={80}
    />
    <div class="page-hero__scrim"></div>
  </div>

  <div class="shell page-hero__inner">
    <div class="lane">
      <div class="page-hero__panel" data-reveal>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        {lead && <p class="lead page-hero__lead">{lead}</p>}
      </div>
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(2.5rem, 7vw, 5rem) clamp(2.5rem, 7vw, 5rem);
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .page-hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 50%;
  }

  .page-hero__media[data-focus='center 38%'] :global(img) {
    object-position: center 38%;
  }

  .page-hero__media[data-focus='center 45%'] :global(img) {
    object-position: center 45%;
  }

  .page-hero__media[data-focus='center 55%'] :global(img) {
    object-position: center 55%;
  }

  /* Only a light unifying veil now — it ties the photograph to the palette and
     takes the edge off busy frames. The contrast work is done by the panel, which
     means the rest of the image can stay almost untouched. */
  .page-hero__scrim {
    position: absolute;
    inset: 0;
    background: rgb(244 247 248 / 0.18);
  }

  /* The text sits on its own surface instead of behind a veil over the whole
     frame. Near-opaque, so contrast is a property of the panel rather than of
     whatever happens to be in the photograph underneath. */
  .page-hero__panel {
    max-width: 44rem;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    background: rgb(244 247 248 / 0.94);
    border-radius: var(--radius-lg);
  }

  @supports (backdrop-filter: blur(1px)) {
    .page-hero__panel {
      background: rgb(244 247 248 / 0.86);
      backdrop-filter: blur(14px) saturate(1.1);
    }
  }

  .page-hero__inner {
    position: relative;
  }

  .eyebrow {
    display: block;
    margin-bottom: var(--space-md);
  }

  .page-hero__lead {
    margin-top: var(--space-md);
    color: var(--ink);
  }

  @media (min-width: 60rem) {
    .page-hero__lead {
      margin-top: var(--space-lg);
    }
  }
</style>
