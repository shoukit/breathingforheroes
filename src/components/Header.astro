---
/**
 * No hamburger. With four short links the menu fits on screen at every width, and
 * a disclosure button would add a JavaScript dependency and a keyboard trap risk
 * for no gain. The nav simply wraps on small screens.
 */
import { nav, primaryCta, site } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path === href.replace(/\/$/, '');
---

<header class="site-header">
  <div class="shell site-header__inner">
    {/* Placeholder wordmark in the logo's colours. Drop the real file at
        src/assets/logo.svg and swap this block for an <Image> — see docs/06-uebergabe.md. */}
    <a class="wordmark" href="/" aria-label={`${site.name} — Startseite`}>
      <span class="wordmark__name">
        <span class="wordmark__a">Breathing</span>{' '}<span class="wordmark__b">for Heroes</span>
      </span>
      <span class="wordmark__sub">Breathing Techniques &amp; Ice Bathing</span>
    </a>

    <nav class="site-nav" aria-label="Hauptnavigation">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--primary site-header__cta" href={primaryCta.href}>{primaryCta.label}</a>
  </div>
</header>

<style>
  /* Static on small screens on purpose. Wordmark and nav need two rows there, and
     a 166px sticky bar costs a fifth of a 844px viewport at every scroll position
     — more than the persistent CTA is worth, given every section ends with one.
     Desktop keeps it sticky, where the whole header is a single 69px row. */
  .site-header {
    position: static;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 60rem) {
    .site-header {
      position: sticky;
      top: 0;
      background: color-mix(in srgb, var(--paper) 88%, transparent);
      backdrop-filter: blur(10px);
    }
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
    padding-block: var(--space-sm);
  }

  .wordmark {
    display: grid;
    gap: 0.1rem;
    align-content: center;
    min-height: var(--tap);
    text-decoration: none;
  }

  .wordmark__name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }

  .wordmark__a {
    color: var(--logo-navy);
  }

  .wordmark__b {
    color: var(--accent);
  }

  .wordmark__sub {
    font-family: var(--font-display);
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  /* The strapline cannot share the row with the CTA on the narrowest phones. */
  @media (max-width: 26rem) {
    .wordmark__sub {
      display: none;
    }
  }

  @media (min-width: 30rem) {
    .wordmark__name {
      font-size: 1.25rem;
    }
  }

  .site-nav {
    grid-column: 1 / -1;
    grid-row: 2;
    border-top: 1px solid var(--line);
    margin-top: calc(var(--space-xs) * -1);
    padding-top: var(--space-2xs);
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: var(--step-small);
    text-decoration: none;
    color: var(--ink-soft);
    border-bottom: 2px solid transparent;
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }

  .site-nav a:hover {
    color: var(--ink);
  }

  .site-nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .site-header__cta {
    /* Slimmer than a body CTA — it must not outweigh the one on the page. */
    min-height: 40px;
    padding: 0.4rem 1rem;
    font-size: var(--step-small);
  }

  @media (min-width: 60rem) {
    .site-header__inner {
      grid-template-columns: auto 1fr auto;
      gap: var(--space-xl);
    }

    .site-nav {
      grid-column: 2;
      grid-row: 1;
      border-top: 0;
      margin-top: 0;
      padding-top: 0;
    }

    .site-nav ul {
      gap: var(--space-lg);
    }

    .site-header__cta {
      min-height: var(--tap);
      padding: 0.6rem 1.25rem;
    }
  }
</style>
