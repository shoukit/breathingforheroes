---
/**
 * A small set of marks drawn from the logo's own vocabulary — its wave, its ice
 * crystal, the thin arc above them — rather than icons pulled from a generic set.
 * They are the one decorative element on the page, so they stay line-only, stay
 * small, and never appear more than once per section.
 *
 * Not a replacement for the lucide icons: those label real UI. These are ornament.
 */

type Name = 'wave' | 'crystal' | 'arc' | 'breath' | 'drop';

interface Props {
  name: Name;
  size?: number;
  class?: string;
}

const { name, size = 40, class: className } = Astro.props;

const marks: Record<Name, string> = {
  // The logo's flowing double line, simplified to two strokes.
  wave: `
    <path d="M3 15c4 0 6-5 10-5s6 5 10 5 6-5 10-5" />
    <path d="M5 24c4 0 6-4 9-4s5 4 9 4 6-4 9-4" opacity="0.45" />
  `,
  // The ice shard cluster, for anything to do with cold.
  crystal: `
    <path d="M20 4v32" />
    <path d="M20 12 12 6M20 12l8-6" />
    <path d="M20 22l-9 -6M20 22l9 -6" />
    <path d="M20 31l-7 -4M20 31l7 -4" opacity="0.5" />
  `,
  // The thin arc that sits over the mark.
  arc: `
    <path d="M5 28a15 15 0 0 1 30 0" />
    <path d="M12 28a8 8 0 0 1 16 0" opacity="0.45" />
  `,
  // Breath moving out and settling — concentric, never closed.
  breath: `
    <circle cx="20" cy="20" r="5" />
    <path d="M20 9a11 11 0 0 1 11 11" />
    <path d="M20 31a11 11 0 0 1 -11 -11" />
    <path d="M20 3a17 17 0 0 1 17 17" opacity="0.4" />
    <path d="M20 37a17 17 0 0 1 -17 -17" opacity="0.4" />
  `,
  // Water, for the ice bath.
  drop: `
    <path d="M20 6c6 8 10 12 10 17a10 10 0 0 1 -20 0c0-5 4-9 10-17z" />
    <path d="M15 24a5 5 0 0 0 5 5" opacity="0.5" />
  `,
};
---

<svg
  class:list={['ornament', className]}
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={marks[name]}
/>

<style>
  .ornament {
    color: var(--logo-teal);
    flex: none;
  }
</style>
