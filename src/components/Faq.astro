---
/**
 * Native <details>. Works without JavaScript, is keyboard operable and searchable
 * in-page by the browser. No custom accordion.
 */
import type { FaqItem } from '../data/faq';

interface Props {
  items: readonly FaqItem[];
  heading?: string;
  eyebrow?: string;
}

const { items, heading = 'Häufige Fragen', eyebrow = 'FAQ' } = Astro.props;
---

<section class="band" aria-labelledby="faq-heading">
  <div class="shell">
    <div class="lane">
      <div class="section-head" data-reveal>
        <span class="mono">{eyebrow}</span>
        <h2 id="faq-heading">{heading}</h2>
      </div>

      <div class="faq" data-reveal>
        {
          items.map((item) => (
            <details name="faq">
              <summary>
                <span>{item.q}</span>
                <svg
                  class="faq__chev"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <div class="faq__body">
                <p>{item.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq {
    max-width: var(--measure);
    border-top: 1px solid var(--line);
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: var(--tap);
    padding-block: var(--space-md);
    cursor: pointer;
    font-weight: 500;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--accent);
  }

  .faq__chev {
    flex: none;
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq__chev {
      transition: transform var(--t-base) var(--ease);
    }
  }

  details[open] .faq__chev {
    transform: rotate(180deg);
  }

  .faq__body {
    padding-bottom: var(--space-md);
    color: var(--ink-soft);
    max-width: 62ch;
  }
</style>
