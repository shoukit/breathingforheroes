---
/**
 * The only page shell. Owns <head>, skip link, header, footer and structured data.
 * Pages never write their own meta tags — they pass props.
 */
/**
 * `opsz` rather than `index`: the default build ships only the weight axis, which
 * silently made every `font-variation-settings: 'opsz' …` in the stylesheets inert.
 * The optical-size axis is what makes the display face hold up at hero size, so it
 * is worth its 30 kB. SOFT and WONK stay out — we set both to their defaults.
 *
 * Latin-only subsets: German needs nothing beyond it, and the full package would
 * ship Cyrillic, Greek and Vietnamese files that are never requested.
 */
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';

/**
 * The two faces that render above the fold. Without a preload the browser only
 * discovers them after the stylesheet parses, which costs a round trip on the LCP
 * text. Imported as URLs so the hashed filenames stay correct across builds.
 */
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import plexLatin from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, person, contact } from '../data/site';
import { offers } from '../data/offers';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD graph nodes, e.g. FAQPage on pages that carry an FAQ. */
  schema?: Record<string, unknown>[];
  ogImage?: string;
}

const { title, description, schema = [], ogImage = '/og-default.jpg' } = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;

const businessId = `${site.url}/#practice`;

const localBusiness = {
  '@type': ['LocalBusiness', 'HealthAndBeautyBusiness'],
  '@id': businessId,
  name: site.name,
  url: site.url,
  telephone: contact.phone,
  email: contact.email,
  founder: { '@type': 'Person', name: person.name, jobTitle: person.role },
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.street,
    postalCode: contact.postalCode,
    addressLocality: contact.city,
    addressCountry: contact.country,
  },
  areaServed: { '@type': 'City', name: contact.city },
  availableLanguage: 'de',
  makesOffer: offers.map((o) => ({
    '@type': 'Offer',
    name: o.name,
    price: o.priceNumeric,
    priceCurrency: 'EUR',
    category: 'Breathwork',
  })),
};

const graph = [localBusiness, ...schema];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexLatin} as="font" type="font/woff2" crossorigin />

    <meta name="theme-color" content="#f5f2ee" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
    />
  </head>

  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />

    <script>
      // Progressive enhancement only: without it every section is already visible.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll('[data-reveal]');

      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px' }
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
